# Groq API Key (required for live LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Groq Free-Tier Model Routing (distinct models per role to avoid single 8K TPM saturation)
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m
GROQ_DECOMPOSER_MODEL=openai/gpt-oss-20b
GROQ_PROPONENT_MODEL=qwen/qwen3.8-27b
GROQ_SKEPTIC_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b

# SQLite Database Paths
CHECKPOINTS_DB_PATH=checkpoints.db
DEBATES_DB_PATH=debates.db

# Optional prompt guard gate (false by default for high throughput)
ENABLE_PROMPT_GUARD=false
